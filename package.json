{
  "name": "marklive",
  "displayName": "Marklive — Live Markdown Editor",
  "description": "Edit Markdown files directly in their rendered form (Obsidian-style Live Preview) while keeping Markdown as the source of truth and Git diffs clean.",
  "version": "0.1.1",
  "publisher": "victorsauter",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorsauter/marklive.git"
  },
  "bugs": {
    "url": "https://github.com/victorsauter/marklive/issues"
  },
  "homepage": "https://github.com/victorsauter/marklive#readme",
  "preview": true,
  "license": "MIT",
  "private": true,
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "live preview",
    "editor",
    "mermaid"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "marklive.editor",
        "displayName": "Marklive",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "marklive.openLive",
        "title": "Open in Live Editor",
        "category": "Marklive",
        "icon": "$(preview)"
      },
      {
        "command": "marklive.openSource",
        "title": "Open in Source Editor",
        "category": "Marklive",
        "icon": "$(code)"
      },
      {
        "command": "marklive.openSplit",
        "title": "Open Source and Live Side by Side",
        "category": "Marklive",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "marklive.find",
        "title": "Find",
        "category": "Marklive"
      },
      {
        "command": "marklive.toggle",
        "title": "Toggle Live / Source",
        "category": "Marklive"
      },
      {
        "command": "marklive.disableDefault",
        "title": "Disable Marklive as Default Editor",
        "category": "Marklive"
      },
      {
        "command": "marklive.enableDefault",
        "title": "Enable Marklive as Default Editor",
        "category": "Marklive"
      }
    ],
    "keybindings": [
      {
        "command": "marklive.toggle",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "activeCustomEditorId == 'marklive.editor' || (editorTextFocus && editorLangId == 'markdown' && !isInDiffEditor)"
      },
      {
        "command": "marklive.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'marklive.editor'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "marklive.openLive",
          "when": "editorLangId == 'markdown' && !isInDiffEditor && activeCustomEditorId != 'marklive.editor'",
          "group": "navigation@-10"
        },
        {
          "command": "marklive.openSplit",
          "when": "editorLangId == 'markdown' && !isInDiffEditor && activeCustomEditorId != 'marklive.editor'",
          "group": "navigation@-9"
        },
        {
          "command": "marklive.openSource",
          "when": "activeCustomEditorId == 'marklive.editor'",
          "group": "navigation@-10"
        }
      ],
      "commandPalette": [
        {
          "command": "marklive.openLive",
          "when": "editorLangId == 'markdown' || resourceExtname =~ /\\.(md|markdown)$/"
        },
        {
          "command": "marklive.openSource",
          "when": "activeCustomEditorId == 'marklive.editor'"
        },
        {
          "command": "marklive.openSplit",
          "when": "editorLangId == 'markdown' || activeCustomEditorId == 'marklive.editor'"
        },
        {
          "command": "marklive.find",
          "when": "activeCustomEditorId == 'marklive.editor'"
        },
        {
          "command": "marklive.toggle",
          "when": "editorLangId == 'markdown' || activeCustomEditorId == 'marklive.editor'"
        }
      ]
    },
    "configuration": {
      "title": "Marklive",
      "properties": {
        "marklive.syntaxReveal": {
          "type": "boolean",
          "default": true,
          "description": "Reveal Markdown syntax (**, #, [..](..), `) around the element under the cursor, Obsidian-style."
        },
        "marklive.syncDelay": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay (ms) before edits made in the Live editor are written to the underlying text document."
        },
        "marklive.mermaid.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Render ```mermaid code blocks as diagrams."
        },
        "marklive.maxWidth": {
          "type": "string",
          "default": "900px",
          "description": "Maximum width of the editing column (CSS length, e.g. 900px or 100%)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run build && tsc -p test/integration/tsconfig.json",
    "test:integration": "vscode-test",
    "validate:repos": "esbuild scripts/validate-repos.ts --bundle --platform=node --format=esm --outfile=out/validate-repos.mjs --log-level=warning && node out/validate-repos.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "package": "npm run check && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build:prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-blockquote": "^3.31.4",
    "@tiptap/extension-bold": "^3.31.4",
    "@tiptap/extension-code": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-horizontal-rule": "^3.31.4",
    "@tiptap/extension-italic": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-strike": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "decode-named-character-reference": "^1.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "lowlight": "^3.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.0",
    "mermaid": "^12.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "mocha": "^11.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "unified": "^11.0.5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
